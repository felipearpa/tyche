+    /// The load a column starts when it appears. Returns without loading when the appearance
+    /// task is already cancelled.
+    ///
+    /// SwiftUI can start and cancel a view's `task` within one update: on iOS 18 it does so
+    /// for a column in a non-selected tab each time that column updates. Refreshing there
+    /// would publish a loading state, update the column again, and start the next cancelled
+    /// task, so a single update would reload the list on every frame. Explicit refreshes
+    /// (pull to refresh, Retry) call ``refresh()`` and are not affected.
+    func refreshOnAppear() async {
+        guard !Task.isCancelled else { return }
+        await refresh()
+    }
